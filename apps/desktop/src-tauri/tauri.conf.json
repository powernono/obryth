{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obryth",
  "version": "0.1.0",
  "identifier": "app.obryth.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Obryth",
        "width": 1440,
        "height": 960,
        "minWidth": 780,
        "minHeight": 580,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Obryth/**"]
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/prosperod-rs",
      "licenses/react-activity-calendar.txt",
      "../../../vendor/prospero/LICENSE",
      "../src/assets/fonts/JetBrainsMono-OFL.txt",
      "../src/assets/fonts/JetBrainsMonoNerdFont-OFL.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
